<Window x:Class="DrawingTakeoff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrawingTakeoff | AI Quantity Takeoff"
        Height="900" Width="1280" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#18324B"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7C8F"/>
        <SolidColorBrush x:Key="Line" Color="#DCE4ED"/>
        <SolidColorBrush x:Key="Accent" Color="#1769AA"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E8EEF5"/>
            <Setter Property="Foreground" Value="#20364D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#157347"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="#C9D5E2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F8FC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF4"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F1F4F8"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="MinRowHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderHeight" Value="52"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Keep the text presenter stretched so long descriptions wrap; the text itself is centered. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E8EEF4"/>
        </Style>
        <Style x:Key="WrappedGridText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF0F6"/>
            <Setter Property="Foreground" Value="#25415D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#DCE4ED"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                                   FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#17324D" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DRAWING TAKEOFF" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="AI-assisted construction material identification and quantity review" Foreground="#C6D6E6" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="REFERENCE CATALOG" Foreground="#AFC3D8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CatalogInfo" Text="Loading catalog..." Foreground="White" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Files + model -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="84"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DRAWINGS" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PdfCountText" Text="0 PDFs selected" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add PDFs" Click="AddPdfs_Click" Margin="0,0,8,0"/>
                    <Button Content="Remove selected" Click="RemovePdf_Click"/>
                </StackPanel>
                <ListBox x:Name="PdfList" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                         SelectionMode="Extended" AllowDrop="True" Drop="PdfList_Drop"
                         BorderBrush="#E5EBF2" BorderThickness="1" Background="#FAFCFE">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#40566C" FontSize="12" TextTrimming="CharacterEllipsis" Margin="5,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Single AI model -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="AI drawing model" VerticalAlignment="Center" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <ComboBox x:Name="AnalysisModelBox" Grid.Column="1" IsEditable="False" SelectionChanged="AnalysisModel_SelectionChanged"/>
                <Button x:Name="RefreshModelsBtn" Grid.Column="2" Content="Refresh models" Click="RefreshModels_Click" Margin="10,0,0,0"/>
                <TextBlock x:Name="ModelHintText" Grid.Column="3" Text="One AI request per page. A vision model analyses the drawing image and extracted text together." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- Run and progress -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="RunBtn" Grid.Column="0" Content="Analyse drawings" Style="{StaticResource PrimaryButton}" Click="Run_Click"/>
                <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                <StackPanel Grid.Column="2" Margin="18,0,18,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Ready — add drawing PDFs to begin" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="Elapsed: 00:00" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EstimatedTotalText" Grid.Column="2" Text="Estimated total: --" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RemainingText" Grid.Column="3" Text="Remaining: --" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,7,0,0" Background="#E8EEF5" Foreground="#2196C5"/>
                    <TextBlock x:Name="PdfProcessingText" Text="PDFs: 0 finished · 0 processing · 0 pending"
                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExcelBtn" Content="Export Excel" Style="{StaticResource SuccessButton}" Click="ExportExcel_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="CsvBtn" Content="Export CSV" Click="ExportCsv_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live results -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="TAKEOFF RESULTS" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="ResultCountText" Grid.Column="1" Text="0 materials identified" Foreground="{StaticResource Muted}" FontSize="11"/>
                </Grid>
                <TabControl Grid.Row="1" Background="White" BorderThickness="0">
                    <TabItem Header="Lumber &amp; Hardware">
                        <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" SelectionChanged="Grid_SelectionChanged" Margin="0,6,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  CanUserResizeColumns="True" CanUserReorderColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sl num" Binding="{Binding DisplaySlNo}" Width="58" MinWidth="52" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Sheet / Drawing" Binding="{Binding Sheet}" Width="1.15*" MinWidth="140" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Number of lumber items" Binding="{Binding LumberCountDisplay}" Width="1.05*" MinWidth="118" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Lumber item" Binding="{Binding LumberItemDisplay}" Width="1.8*" MinWidth="190" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Number of hardware items" Binding="{Binding HardwareCountDisplay}" Width="1.05*" MinWidth="122" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Hardware item" Binding="{Binding HardwareItemDisplay}" Width="1.8*" MinWidth="190" ElementStyle="{StaticResource WrappedGridText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Other identified materials">
                        <DataGrid x:Name="OtherGrid" AutoGenerateColumns="False" SelectionChanged="Grid_SelectionChanged" Margin="0,6,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  CanUserResizeColumns="True" CanUserReorderColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sl num" Binding="{Binding OtherSlNo}" Width="58" MinWidth="52" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Sheet / Drawing" Binding="{Binding Sheet}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Number of items" Binding="{Binding OtherCountDisplay}" Width="1*" MinWidth="110" ElementStyle="{StaticResource WrappedGridText}"/>
                                <DataGridTextColumn Header="Other identified item" Binding="{Binding ItemName}" Width="2*" MinWidth="200" ElementStyle="{StaticResource WrappedGridText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Evidence -->
        <Border Grid.Row="5" Background="#EDF3F8" CornerRadius="10" Padding="12,9">
            <StackPanel>
                <TextBlock Text="SOURCE EVIDENCE" Foreground="#38536D" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="EvidenceText" Text="Select a result row to inspect its source page, detail reference and evidence." Foreground="#52677C" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="58"/>
                <TextBlock x:Name="ActivityText" Text="Logs are saved locally for troubleshooting." Foreground="#8797A7" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
